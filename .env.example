# Copy to .env.local (development) or set on your host. Never commit real values.
# Setup guide: docs/setup.md

# Database (required)
DATABASE_URL="postgresql://user:password@localhost:5432/aarambha"

# Object storage, any S3-compatible service (required)
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_PUBLIC_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""
OBJECT_STORAGE_BUCKET="aarambha"
OBJECT_STORAGE_REGION="us-east-1"

# Email via Resend (optional): welcome and password-reset emails for admin users
RESEND_API_KEY=""
MAIL_FROM="Aarambha <noreply@your-verified-domain.org>"
